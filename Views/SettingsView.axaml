<UserControl xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:controls="clr-namespace:GrinLauncher.Controls"
            x:Class="GrinLauncher.Views.SettingsView"
            x:CompileBindings="True">
    <Grid ColumnDefinitions="*,Auto,400">
        <StackPanel Grid.Column="0" Spacing="20"  Margin="0,0,24,0">
            <controls:GlassPanel CornerRadius="14" Padding="20,18">
                <StackPanel Spacing="12">
                    <TextBlock Text="메모리 할당" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Slider Grid.Column="0" x:Name="MemorySlider" Minimum="1" Maximum="16" Value="4" TickFrequency="1"
                                IsSnapToTickEnabled="True" ValueChanged="OnMemoryChanged" Foreground="#89D22F"/>
                        <TextBlock Grid.Column="1" x:Name="MemoryLabelText" Text="6GB" FontSize="13" FontWeight="SemiBold"
                                Foreground="{DynamicResource TextPrimaryBrush}" Width="44" TextAlignment="Right"
                                VerticalAlignment="Center" Margin="14,0,0,0" />
                    </Grid>
                </StackPanel>
            </controls:GlassPanel>

            <controls:GlassPanel CornerRadius="14" Padding="20,18">
                <StackPanel Spacing="10">
                    <TextBlock Text="Java 경로" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBox x:Name="JavaPathText" IsReadOnly="True" FontSize="13" FontFamily="{StaticResource MonoFont}"
                            Foreground="{DynamicResource TextSecondaryBrush}" Background="{DynamicResource BgBrush}"
                            BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" CornerRadius="8" Padding="10,10" />
                </StackPanel>
            </controls:GlassPanel>

            <controls:GlassPanel CornerRadius="14" Padding="20,18">
                <StackPanel Spacing="10">
                    <TextBlock Text="게임 디렉토리" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBox x:Name="GameDirText" IsReadOnly="True" FontSize="13" FontFamily="{StaticResource MonoFont}"
                            Foreground="{DynamicResource TextSecondaryBrush}" Background="{DynamicResource BgBrush}"
                            BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" CornerRadius="8" Padding="10,10" />
                </StackPanel>
            </controls:GlassPanel>
        </StackPanel>

        <Border Grid.Column="1" Width="1" Margin="0,4" VerticalAlignment="Stretch" Background="{DynamicResource BorderBrush2}" />

        <StackPanel Grid.Column="2" Spacing="20" Margin="24,0,0,0">
            <controls:GlassPanel CornerRadius="14" Padding="24" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                <StackPanel Spacing="20">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <Border Width="56" Height="56" CornerRadius="4" ClipToBounds="True" Background="{DynamicResource BorderBrush2}">
                            <Grid>
                                <Path x:Name="AvatarPlaceholder" Width="24" Height="24" Stretch="Uniform"
                                    Data="M12,4 A4,4 0 1 0 12,12 A4,4 0 1 0 12,4 Z M4,20 A8,7 0 0 1 20,20"
                                    Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.4" Fill="Transparent" />
                                <Image x:Name="AvatarFace" Stretch="UniformToFill" IsVisible="False"
                                    RenderOptions.BitmapInterpolationMode="None" />
                                <Image x:Name="AvatarHat" Stretch="UniformToFill" IsVisible="False" Margin="-2,0"
                                    RenderOptions.BitmapInterpolationMode="None" />
                            </Grid>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock x:Name="NicknameText" Text="" FontSize="16" FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock x:Name="UuidText" Text="" FontSize="12" FontFamily="{StaticResource MonoFont}"
                                    Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource BorderBrush2}" />

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="연결된 계정" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Microsoft 계정으로 로그인됨" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                    Margin="0,2,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource BorderBrush2}" CornerRadius="999" Padding="10,4"
                                VerticalAlignment="Center">
                            <TextBlock Text="연결됨" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </Border>
                    </Grid>

                    <!-- 디자인 목업은 로그아웃 텍스트를 빨강(#c0392b)으로 표시하지만, design.md 규칙상
                        라임 외 강조색을 쓰지 않으므로 무채색 아웃라인 버튼으로 유지합니다. -->
                    <Button x:Name="LogoutButton" Classes="cta" Content="로그아웃" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" FontWeight="Normal" FontSize="13" Padding="0,11"
                            Click="OnLogoutClick" />
                </StackPanel>
            </controls:GlassPanel>
        </StackPanel>
    </Grid>
</UserControl>
