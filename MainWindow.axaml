<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GrinLauncher"
    xmlns:views="clr-namespace:GrinLauncher.Views"
    xmlns:rendering="clr-namespace:GrinLauncher.Rendering"
    x:Class="GrinLauncher.MainWindow"
    x:CompileBindings="True"
    Title="Grin Launcher"
    Icon="/Assets/grin_square.png"
    Width="1280" Height="800" MinWidth="960" MinHeight="600"
    CanResize="True"
    TransparencyLevelHint="AcrylicBlur"
    Background="Transparent">

    <Window.Styles>
        <Style Selector="Button.navicon">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- FluentTheme의 기본 Button 컨트롤테마가 :pointerover에서 ContentPresenter
            배경을 회색으로 칠하는 Setter를 갖고 있어, 위에서 Background=Transparent를
            줘도 호버 시 원형(CornerRadius 999) 회색 배경이 그대로 비친다. design.md는
            선택 상태만 유리 원으로 표시하도록 규정하므로 호버 배경은 명시적으로 다시
            투명 처리한다. -->
        <Style Selector="Button.navicon:pointerover">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Border.navcircle">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Styles>

    <Border Background="{DynamicResource BgBrush}">
        <Border.Transitions>
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Border.Transitions>

        <Grid>

            <!-- ===== 로그인 화면 ===== -->
            <StackPanel x:Name="LoginScreen" Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center" Width="360" Spacing="32">
                <Image Source="/Assets/grin_200.png" Width="200"/>
                    <Button CornerRadius="12" x:Name="LoginButton" Classes="cta" Height="40" Width="240"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        FontWeight="Regular" FontSize="14"
                        Click="OnLoginClick">

                        <StackPanel Orientation="Horizontal"
                            Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image Source="/Assets/ms_logo.png" Width="14" Height="14" />
                            <TextBlock Text="Microsoft 로그인"
                                FontWeight="Regular" FontSize="14"
                                Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                <TextBlock x:Name="LoginStatusText" Text="" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"
                    Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>



            <!-- ===== 메인 셸 ===== -->
            <Grid Grid.Row="1">
                <Panel x:Name="Shell" IsVisible="False">

                    <!-- 콘텐츠: 사이드바(8px 여백 + 64px 폭 = 72px)보다 안쪽에서 시작해야
                         텍스트/뱃지가 가려지지 않는다. 스크롤되는 콘텐츠는 여전히 사이드바
                         "밑으로" 지나가므로 유리 재질이 블러링할 픽셀은 있다 -->
                    <Grid Margin="96,24,24,24">
                        <views:HomeView x:Name="HomePage" />
                        <views:SkinsView x:Name="SkinsPage" IsVisible="False" />
                        <views:SettingsView x:Name="SettingsPage" IsVisible="False" />
                    </Grid>

                    <!-- 플로팅 유리 사이드바: 창 가장자리에서 8px, 아이콘 전용 64px 캡슐.
                        2026-08-08: 카드 전반에 유리를 확장하며 한때 재사용 컨트롤
                        controls:GlassPanel로 통합했으나, "사이드바 디자인은 유지해야지"
                        라는 요청에 따라 사이드바만 독립된 마크업 + 전용 토큰
                        (SidebarGlassOverlayBrush/SidebarGlassBorderBrush/
                        SidebarGlassShadow)으로 되돌림 — 톤은 카드와 같지만, 이후 카드
                        쪽 유리를 조정해도 사이드바는 영향받지 않도록 분리 -->
                    <Border x:Name="SidebarGlassFrame" Width="64" Margin="16" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                            CornerRadius="26" Background="Transparent"
                            BorderThickness="1" BorderBrush="{DynamicResource SidebarGlassBorderBrush}"
                            BoxShadow="{DynamicResource SidebarGlassShadow}">
                    <ExperimentalAcrylicBorder CornerRadius="26">
                        <ExperimentalAcrylicBorder.Material>
                            <ExperimentalAcrylicMaterial BackgroundSource="Digger"
                                TintColor="#999999" TintOpacity="0.2"
                                MaterialOpacity="0.6" FallbackColor="White" />
                        </ExperimentalAcrylicBorder.Material>
                        <Panel>
                        <Border CornerRadius="26" IsHitTestVisible="False"
                                Background="{DynamicResource SidebarGlassOverlayBrush}" />
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" Margin="0,16">

                            <Image Grid.Row="0" Source="/Assets/grin_100.png" Width="28"
                                HorizontalAlignment="Center" Margin="0,0,0,16" />

                            <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderBrush2}" Margin="12,0,12,16" />

                            <Button Grid.Row="2" x:Name="NavHomeButton" Classes="navicon" Click="OnNavHomeClick" Margin="0,0,0,14" Padding="4">
                                <Border x:Name="NavHomeCircle" Classes="navcircle" Width="40" Height="40" CornerRadius="999" BorderThickness="0">
                                    <Path x:Name="NavHomeIcon" Width="16" Height="16" Stretch="Uniform"
                                        StrokeThickness="1" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                        Data="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"
                                        Stroke="{DynamicResource TextSecondaryBrush}" />
                                        
                                </Border>
                            </Button>

                            <Button Grid.Row="3" x:Name="NavSkinsButton" Classes="navicon" Click="OnNavSkinsClick" Margin="0,0,0,14" Padding="4">
                                <Border x:Name="NavSkinsCircle" Classes="navcircle" Width="40" Height="40" CornerRadius="999" BorderThickness="0">
                                    <Path x:Name="NavSkinsIcon" Width="16" Height="16" Stretch="Uniform"
                                        StrokeThickness="1" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                        Data="M9.53 16.122a3 3 0 0 0-5.78 1.128 2.25 2.25 0 0 1-2.4 2.245 4.5 4.5 0 0 0 8.4-2.245c0-.399-.078-.78-.22-1.128Zm0 0a15.998 15.998 0 0 0 3.388-1.62m-5.043-.025a15.994 15.994 0 0 1 1.622-3.395m3.42 3.42a15.995 15.995 0 0 0 4.764-4.648l3.876-5.814a1.151 1.151 0 0 0-1.597-1.597L14.146 6.32a15.996 15.996 0 0 0-4.649 4.763m3.42 3.42a6.776 6.776 0 0 0-3.42-3.42"
                                        Stroke="{DynamicResource TextSecondaryBrush}" />
                                </Border>
                            </Button>

                            <Button Grid.Row="4" x:Name="NavSettingsButton" Classes="navicon" Click="OnNavSettingsClick" Margin="0,0,0,14" Padding="4">
                                <Border x:Name="NavSettingsCircle" Classes="navcircle" Width="40" Height="40" CornerRadius="999" BorderThickness="0">
                                    <Path x:Name="NavSettingsIcon" Width="16" Height="16" Stretch="Uniform"
                                        StrokeThickness="1" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                        Data="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.24-.438.613-.43.991.005.11.005.221 0 .33-.008.379.137.75.43.992l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.33c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28ZM15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"
                                        Stroke="{DynamicResource TextSecondaryBrush}" />
                                </Border>
                            </Button>

                            <Button Grid.Row="6" x:Name="NavAccountButton" Classes="navicon" >
                                <Border x:Name="NavAccountCircle" Width="48" Height="48" CornerRadius="999" BorderThickness="0">
                                    <Grid>
                                        <Path x:Name="NavAccountPlaceholder" Width="20" Height="20" Stretch="Uniform"
                                            StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                            Data="M12,4 A4,4 0 1 0 12,12 A4,4 0 1 0 12,4 Z M4,20 A8,7 0 0 1 20,20"
                                            Stroke="{DynamicResource TextSecondaryBrush}" />
                                        <Border Width="32" Height="32" CornerRadius="0" ClipToBounds="True">
                                            <Grid>
                                                <Image x:Name="NavAccountFace" Stretch="UniformToFill" IsVisible="False"
                                                    RenderOptions.BitmapInterpolationMode="None" />
                                                <Image x:Name="NavAccountHat" Stretch="UniformToFill" IsVisible="False" Margin="-2,0"
                                                    RenderOptions.BitmapInterpolationMode="None" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Button>

                        </Grid>
                        </Panel>
                    </ExperimentalAcrylicBorder>
                    </Border>
                </Panel>
            </Grid>
        </Grid>
    </Border>
</Window>
